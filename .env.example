# ---- wire-pod ----
WIREPOD_URL=http://127.0.0.1:8080
# Leave blank to auto-detect from wire-pod. Your ESN is on the bottom of Vector / in wire-pod's Bot Settings.
VECTOR_SERIAL=

# ---- brain (what answers when you talk to Vector) ----
# ollama   = local model on your Mac (free, private)  -> run: ollama pull llama3.2:3b
# anthropic = Claude via API (smartest; needs ANTHROPIC_API_KEY, pay-per-use)
# openai   = any OpenAI-compatible server (set OPENAI_COMPAT_URL / OPENAI_COMPAT_KEY)
BRAIN_BACKEND=ollama
# Blank = default for backend (ollama: llama3.2:3b, anthropic: claude-haiku-5-5)
BRAIN_MODEL=
BRAIN_PORT=11500
ANTHROPIC_API_KEY=
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=

# ---- personal context ----
VECTOR_OWNER=Rushil
# Vector can mention what you've been committing lately
PROJECTS_DIR=
